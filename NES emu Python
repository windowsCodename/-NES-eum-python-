# 2. Bus
# ------------------------------------------------------------
class Bus:
    def __init__(self):
        self.ram = bytearray(0x800)
        self.sram = bytearray(0x2000)
        self.prg = bytearray(0x8000)
        self.chr = bytearray(0x2000)
        self.vram = bytearray(0x1000)
        self.palette = bytearray(0x20)
        self.ppu_regs = [0]*8
        self.oam = bytearray(256)
        self.joy1_bits = [0]*8
        self.joy1_idx = 0
        self.joy_strobe = 0
        self.nmi_flag = False
    def ram_read(self, a):
        return self.ram[a % 0x800]
    def ram_write(self, a, v):
        self.ram[a % 0x800] = v & 0xFF
    def read(self, a):
        a &= 0xFFFF
        if a < 0x2000:
            return self.ram[a % 0x800]
        if a < 0x4000:
            return self.ppu_read_reg((a-0x2000)%8)
        if a == 0x4016:
            return self.joy_read()
        if 0x4000 <= a < 0x4020:
            return 0
        if 0x6000 <= a < 0x8000:
            return self.sram[(a-0x6000)%0x2000]
        if a >= 0x8000:
            return self.prg[(a-0x8000)%0x8000]
        return 0
    def write(self, a, v):
        v &= 0xFF
        a &= 0xFFFF
        if a < 0x2000:
            self.ram[a % 0x800] = v
            return
        if a < 0x4000:
            self.ppu_write_reg((a-0x2000)%8, v)
            return
        if a == 0x4014:
            base = (v<<8)
            for i in range(256):
                self.oam[i] = self.read((base+i)&0xFFFF)
            return
        if a == 0x4016:
            self.joy_write(v)
            return
        if 0x4000 <= a < 0x4020:
            return
        if 0x6000 <= a < 0x8000:
            self.sram[(a-0x6000)%0x2000] = v
            return
    def ppu_read_reg(self, r):
        if r == 2:
            v = 0x80 if self.nmi_flag else 0
            self.nmi_flag = False
            return v
        return self.ppu_regs[r]
    def ppu_write_reg(self, r, v):
        self.ppu_regs[r] = v & 0xFF
        if r == 1 and (v & 0x80):
            pass
    def joy_write(self, v):
        if v & 1:
            self.joy1_idx = 0
        self.joy_strobe = v & 1
    def joy_read(self):
        if self.joy1_idx >= 8:
            return 1
        b = self.joy1_bits[self.joy1_idx]
        if not self.joy_strobe:
            self.joy1_idx += 1
        return b
    def set_buttons(self, a,b,sel,sta,up,dn,lf,rt):
        self.joy1_bits = [a,b,sel,sta,up,dn,lf,rt]
