def emu_thread():
    acc = 0
    while True:
        if cpu.running and not cpu.paused:
            for _ in range(CYCLES_PER_FRAME//3):
                cpu.step()
                if not cpu.running:
                    break
            ppu.vblank()
            try:
                cpu.nmi()
            except:
                pass
        time.sleep(1/60)
