def load_nes(path, bus):
    with open(path, "rb") as f:
        d = f.read()
    if d[0:4] != b'NES\x1a':
        raise ValueError("NES header invalid")
    prg_n = d[4]
    chr_n = d[5]
    mapper = (d[6]>>4)|((d[7]>>4)<<4)
    LOG.log(f"[ROM] mapper={mapper} prg={prg_n} chr={chr_n}")
    if mapper != 0:
        raise ValueError(f"Mapper {mapper} not supported - Mario needs Mapper0 version")
    off = 16
    if d[6] & 4:
        off += 512
    prg = d[off:off+prg_n*16384]
    off += prg_n*16384
    ch = d[off:off+chr_n*8192]
    if len(prg) == 16384:
        bus.prg[0:16384] = prg
        bus.prg[16384:32768] = prg
    else:
        bus.prg[0:32768] = prg[:32768]
    if len(ch) >= 8192:
        bus.chr[0:8192] = ch[:8192]
    # vectors fallback
    if bus.read(0xFFFC) == 0 and bus.read(0xFFFD) == 0:
        bus.prg[0x7FFC] = 0x00
        bus.prg[0x7FFD] = 0x80
    LOG.log(f"[ROM] loaded PRG={len(prg)} CHR={len(ch)}")
    return len(prg), len(ch)
