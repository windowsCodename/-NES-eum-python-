# 4. PPU fake but working for Mario
# ------------------------------------------------------------
NES_PAL = ["#000000","#222222","#555555","#888888","#AAAAAA","#CCCCCC","#FFFFFF","#FF0000","#00FF00","#0000FF","#FFFF00","#00FFFF","#FF00FF","#FF8800","#884400","#88FF88"]
class PPU:
    def __init__(self, bus):
        self.b = bus
        self.frame = 0
        self.scroll_x = 0
        self.scroll_y = 0
    def vblank(self):
        self.b.nmi_flag = True
        self.frame += 1
        # Mario uses $2002 bit7 to sync
        # animate scroll from RAM $0086 style
        try:
            self.scroll_x = (self.scroll_x+1) % 512
        except:
            pass
    def render(self, img):
        # Render CHR patterns + OAM sprites as pixels
        # Fast enough: step 1 pixel but low overhead
        B = self.b
        # Build string for PhotoImage.put
        # Use RAM $0200 as OAM mirror already in bus.oam
        rows = []
        for y in range(0, 240, 1):
            line = []
            for x in range(0, 256, 1):
                tx = (x + (B.ram[0x86] if len(B.ram)>0x86 else 0)) % 256
                ty = y
                tile_x = tx//8
                tile_y = ty//8
                tid = (tile_y*32+tile_x) % 512
                base = tid*16+(ty%8)
                b0 = B.chr[base % 8192]
                b1 = B.chr[(base+8) % 8192]
                bit = 7-(tx%8)
                pix = ((b1>>bit)&1)*2+((b0>>bit)&1)
                # sprite overlay check simple
                for s in range(0, 64*4, 4):
                    sy = B.oam[s]
                    sx = B.oam[s+3]
                    if abs(int(sx)-x) < 8 and abs(int(sy)-y) < 8:
                        pix = (pix+3) & 3
                        break
                if pix == 0:
                    c = "#1a0a3a"
                elif pix == 1:
                    c = "#5a5aff"
                elif pix == 2:
                    c = "#ff5555"
                else:
                    c = "#ffffff"
                line.append(c)
            rows.append("{"+" ".join(line)+"}")
        try:
            img.put(" ".join(rows))
        except Exception as e:
            pass
