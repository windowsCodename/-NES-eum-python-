# 3. CPU 6502 FULL
# ------------------------------------------------------------
class CPU:
    def __init__(self, bus):
        self.b = bus
        self.a = 0
        self.x = 0
        self.y = 0
        self.sp = 0xFD
        self.pc = 0x8000
        self.C = 0
        self.Z = 0
        self.I = 1
        self.D = 0
        self.V = 0
        self.N = 0
        self.running = False
        self.paused = False
        self.cycles = 0
        self.count = 0
        self.last = ""
        self.unk = {}
    def reset(self):
        lo = self.b.read(0xFFFC)
        hi = self.b.read(0xFFFD)
        vec = (hi<<8)|lo
        if vec == 0 or vec == 0xFFFF:
            vec = 0x8000
        self.pc = vec
        self.sp = 0xFD
        self.I = 1
        self.running = True
        self.paused = False
        LOG.log(f"[SYS] RESET PC={vec:04X}")
    def nmi(self):
        self.push((self.pc>>8)&0xFF)
        self.push(self.pc&0xFF)
        self.push(self.flags()|0x20)
        self.I = 1
        lo = self.b.read(0xFFFA)
        hi = self.b.read(0xFFFB)
        vec = (hi<<8)|lo
        if vec != 0:
            self.pc = vec
        self.cycles += 7
    def irq(self):
        if self.I:
            return
        self.push((self.pc>>8)&0xFF)
        self.push(self.pc&0xFF)
        self.push(self.flags()|0x20)
        self.I = 1
        lo = self.b.read(0xFFFE)
        hi = self.b.read(0xFFFF)
        self.pc = (hi<<8)|lo
    def flags(self):
        return self.C|self.Z<<1|self.I<<2|self.D<<3|1<<4|1<<5|self.V<<6|self.N<<7
    def set_flags(self, f):
        self.C = f&1
        self.Z = (f>>1)&1
        self.I = (f>>2)&1
        self.D = (f>>3)&1
        self.V = (f>>6)&1
        self.N = (f>>7)&1
    def push(self, v):
        self.b.write(0x100+self.sp, v)
        self.sp = (self.sp-1)&0xFF
    def pull(self):
        self.sp = (self.sp+1)&0xFF
        return self.b.read(0x100+self.sp)
    def fetch(self):
        v = self.b.read(self.pc)
        self.pc = (self.pc+1)&0xFFFF
        return v
    def zn(self, v):
        v &= 0xFF
        self.Z = 1 if v == 0 else 0
        self.N = 1 if v & 0x80 else 0
        return v
    def adc(self, v):
        r = self.a+v+self.C
        self.C = 1 if r > 0xFF else 0
        self.V = 1 if (~(self.a^v)&(self.a^r)&0x80) else 0
        self.a = self.zn(r)
    def sbc(self, v):
        r = self.a-v-(1-self.C)
        self.C = 0 if r < 0 else 1
        self.V = 1 if ((self.a^v)&(self.a&r)&0x80) else 0
        self.a = self.zn(r&0xFF)
    def cmp_r(self, r, v):
        self.C = 1 if r >= v else 0
        self.zn((r-v)&0xFF)
    def asl_m(self, a):
        v = self.b.read(a)
        self.C = (v>>7)&1
        v = self.zn((v<<1)&0xFF)
        self.b.write(a, v)
    def lsr_m(self, a):
        v = self.b.read(a)
        self.C = v&1
        v = self.zn(v>>1)
        self.b.write(a, v)
    def rol_m(self, a):
        v = self.b.read(a)
        nc = (v>>7)&1
        v = self.zn(((v<<1)|self.C)&0xFF)
        self.C = nc
        self.b.write(a, v)
    def ror_m(self, a):
        v = self.b.read(a)
        nc = v&1
        v = self.zn(((self.C<<7)|(v>>1))&0xFF)
        self.C = nc
        self.b.write(a, v)
    def zp(self):
        return self.fetch()
    def zpx(self):
        return (self.fetch()+self.x)&0xFF
    def zpy(self):
        return (self.fetch()+self.y)&0xFF
    def abs_(self):
        lo = self.fetch()
        hi = self.fetch()
        return (hi<<8)|lo
    def absx(self):
        return (self.abs_()+self.x)&0xFFFF
    def absy(self):
        return (self.abs_()+self.y)&0xFFFF
    def indx(self):
        b = (self.fetch()+self.x)&0xFF
        lo = self.b.read(b)
        hi = self.b.read((b+1)&0xFF)
        return (hi<<8)|lo
    def indy(self):
        b = self.fetch()
        lo = self.b.read(b)
        hi = self.b.read((b+1)&0xFF)
        return ((hi<<8)|lo)+self.y & 0xFFFF
    def branch(self, c):
        off = self.fetch()
        if c:
            rel = off-256 if off > 127 else off
            self.pc = (self.pc+rel)&0xFFFF
            self.cycles += 1
    def step(self):
        if not self.running or self.paused:
            return 0
        pc0 = self.pc
        op = self.fetch()
        self.count += 1
        self.cycles += 2
        n = self.exec(op)
        self.last = f"{pc0:04X}:{op:02X}"
        self.cycles += n
        return n
    def exec(self, op):
        B = self.b
        F = self.fetch
        # --- LDA ---
        if op == 0xA9:
            self.a = self.zn(F())
            return 2
        if op == 0xA5:
            self.a = self.zn(B.read(self.zp()))
            return 3
        if op == 0xB5:
            self.a = self.zn(B.read(self.zpx()))
            return 4
        if op == 0xAD:
            self.a = self.zn(B.read(self.abs_()))
            return 4
        if op == 0xBD:
            self.a = self.zn(B.read(self.absx()))
            return 4
        if op == 0xB9:
            self.a = self.zn(B.read(self.absy()))
            return 4
        if op == 0xA1:
            self.a = self.zn(B.read(self.indx()))
            return 6
        if op == 0xB1:
            self.a = self.zn(B.read(self.indy()))
            return 5
        # --- LDX ---
        if op == 0xA2:
            self.x = self.zn(F())
            return 2
        if op == 0xA6:
            self.x = self.zn(B.read(self.zp()))
            return 3
        if op == 0xB6:
            self.x = self.zn(B.read(self.zpy()))
            return 4
        if op == 0xAE:
            self.x = self.zn(B.read(self.abs_()))
            return 4
        if op == 0xBE:
            self.x = self.zn(B.read(self.absy()))
            return 4
        # --- LDY ---
        if op == 0xA0:
            self.y = self.zn(F())
            return 2
        if op == 0xA4:
            self.y = self.zn(B.read(self.zp()))
            return 3
        if op == 0xB4:
            self.y = self.zn(B.read(self.zpx()))
            return 4
        if op == 0xAC:
            self.y = self.zn(B.read(self.abs_()))
            return 4
        if op == 0xBC:
            self.y = self.zn(B.read(self.absx()))
            return 4
        # --- STA ---
        if op == 0x85:
            B.write(self.zp(), self.a)
            return 3
        if op == 0x95:
            B.write(self.zpx(), self.a)
            return 4
        if op == 0x8D:
            B.write(self.abs_(), self.a)
            return 4
        if op == 0x9D:
            B.write(self.absx(), self.a)
            return 5
        if op == 0x99:
            B.write(self.absy(), self.a)
            return 5
        if op == 0x81:
            B.write(self.indx(), self.a)
            return 6
        if op == 0x91:
            B.write(self.indy(), self.a)
            return 6
        # --- STX STY ---
        if op == 0x86:
            B.write(self.zp(), self.x)
            return 3
        if op == 0x96:
            B.write(self.zpy(), self.x)
            return 4
        if op == 0x8E:
            B.write(self.abs_(), self.x)
            return 4
        if op == 0x84:
            B.write(self.zp(), self.y)
            return 3
        if op == 0x94:
            B.write(self.zpx(), self.y)
            return 4
        if op == 0x8C:
            B.write(self.abs_(), self.y)
            return 4
        # --- Transfers ---
        if op == 0xAA:
            self.x = self.zn(self.a)
            return 2
        if op == 0x8A:
            self.a = self.zn(self.x)
            return 2
        if op == 0xA8:
            self.y = self.zn(self.a)
            return 2
        if op == 0x98:
            self.a = self.zn(self.y)
            return 2
        if op == 0xBA:
            self.x = self.zn(self.sp)
            return 2
        if op == 0x9A:
            self.sp = self.x
            return 2
        # --- Inx Dey etc ---
        if op == 0xE8:
            self.x = self.zn((self.x+1)&0xFF)
            return 2
        if op == 0xCA:
            self.x = self.zn((self.x-1)&0xFF)
            return 2
        if op == 0xC8:
            self.y = self.zn((self.y+1)&0xFF)
            return 2
        if op == 0x88:
            self.y = self.zn((self.y-1)&0xFF)
            return 2
        if op == 0xE6:
            a = self.zp()
            v = self.zn((B.read(a)+1)&0xFF)
            B.write(a, v)
            return 5
        if op == 0xF6:
            a = self.zpx()
            v = self.zn((B.read(a)+1)&0xFF)
            B.write(a, v)
            return 6
        if op == 0xEE:
            a = self.abs_()
            v = self.zn((B.read(a)+1)&0xFF)
            B.write(a, v)
            return 6
        if op == 0xC6:
            a = self.zp()
            v = self.zn((B.read(a)-1)&0xFF)
            B.write(a, v)
            return 5
        if op == 0xD6:
            a = self.zpx()
            v = self.zn((B.read(a)-1)&0xFF)
            B.write(a, v)
            return 6
        if op == 0xCE:
            a = self.abs_()
            v = self.zn((B.read(a)-1)&0xFF)
            B.write(a, v)
            return 6
        # --- Jumps ---
        if op == 0x4C:
            self.pc = self.abs_()
            return 3
        if op == 0x6C:
            p = self.abs_()
            lo = B.read(p)
            hi = B.read((p&0xFF00)|((p+1)&0xFF))
            self.pc = (hi<<8)|lo
            return 5
        if op == 0x20:
            lo = F()
            hi = F()
            ret = (self.pc-1)&0xFFFF
            self.push((ret>>8)&0xFF)
            self.push(ret&0xFF)
            self.pc = (hi<<8)|lo
            return 6
        if op == 0x60:
            lo = self.pull()
            hi = self.pull()
            self.pc = (((hi<<8)|lo)+1)&0xFFFF
            return 6
        if op == 0x40:
            self.set_flags(self.pull())
            lo = self.pull()
            hi = self.pull()
            self.pc = (hi<<8)|lo
            return 6
        # --- Branches ---
        if op == 0xD0:
            self.branch(self.Z==0)
            return 2
        if op == 0xF0:
            self.branch(self.Z==1)
            return 2
        if op == 0x10:
            self.branch(self.N==0)
            return 2
        if op == 0x30:
            self.branch(self.N==1)
            return 2
        if op == 0x90:
            self.branch(self.C==0)
            return 2
        if op == 0xB0:
            self.branch(self.C==1)
            return 2
        if op == 0x50:
            self.branch(self.V==0)
            return 2
        if op == 0x70:
            self.branch(self.V==1)
            return 2
        # --- Logic ---
        if op == 0x29:
            self.a = self.zn(self.a&F())
            return 2
        if op == 0x25:
            self.a = self.zn(self.a&B.read(self.zp()))
            return 3
        if op == 0x2D:
            self.a = self.zn(self.a&B.read(self.abs_()))
            return 4
        if op == 0x09:
            self.a = self.zn(self.a|F())
            return 2
        if op == 0x05:
            self.a = self.zn(self.a&B.read(self.zp()))
            return 3
        if op == 0x0D:
            self.a = self.zn(self.a&B.read(self.abs_()))
            return 4
        if op == 0x49:
            self.a = self.zn(self.a^F())
            return 2
        if op == 0x45:
            self.a = self.zn(self.a^B.read(self.zp()))
            return 3
        if op == 0x4D:
            self.a = self.zn(self.a^B.read(self.abs_()))
            return 4
        if op == 0x24:
            v = B.read(self.zp())
            self.V = (v>>6)&1
            self.Z = 1 if (self.a&v)==0 else 0
            self.N = 1 if v&0x80 else 0
            return 3
        if op == 0x2C:
            v = B.read(self.abs_())
            self.V = (v>>6)&1
            self.Z = 1 if (self.a&v)==0 else 0
            self.N = 1 if v&0x80 else 0
            return 4
        # --- Compare ---
        if op == 0xC9:
            self.cmp_r(self.a, F())
            return 2
        if op == 0xC5:
            self.cmp_r(self.a, B.read(self.zp()))
            return 3
        if op == 0xCD:
            self.cmp_r(self.a, B.read(self.abs_()))
            return 4
        if op == 0xE0:
            self.cmp_r(self.x, F())
            return 2
        if op == 0xE4:
            self.cmp_r(self.x, B.read(self.zp()))
            return 3
        if op == 0xEC:
            self.cmp_r(self.x, B.read(self.abs_()))
            return 4
        if op == 0xC0:
            self.cmp_r(self.y, F())
            return 2
        if op == 0xC4:
            self.cmp_r(self.y, B.read(self.zp()))
            return 3
        if op == 0xCC:
            self.cmp_r(self.y, B.read(self.abs_()))
            return 4
        # --- ADC SBC ---
        if op == 0x69:
            self.adc(F())
            return 2
        if op == 0x65:
            self.adc(B.read(self.zp()))
            return 3
        if op == 0x6D:
            self.adc(B.read(self.abs_()))
            return 4
        if op == 0x7D:
            self.adc(B.read(self.absx()))
            return 4
        if op == 0x61:
            self.adc(B.read(self.indx()))
            return 6
        if op == 0x71:
            self.adc(B.read(self.indy()))
            return 5
        if op == 0xE9:
            self.sbc(F())
            return 2
        if op == 0xE5:
            self.sbc(B.read(self.zp()))
            return 3
        if op == 0xED:
            self.sbc(B.read(self.abs_()))
            return 4
        if op == 0xF1:
            self.sbc(B.read(self.indy()))
            return 5
        # --- Shifts ---
        if op == 0x0A:
            self.C = (self.a>>7)&1
            self.a = self.zn((self.a<<1)&0xFF)
            return 2
        if op == 0x06:
            self.asl_m(self.zp())
            return 5
        if op == 0x0E:
            self.asl_m(self.abs_())
            return 6
        if op == 0x4A:
            self.C = self.a&1
            self.a = self.zn(self.a>>1)
            return 2
        if op == 0x46:
            self.lsr_m(self.zp())
            return 5
        if op == 0x4E:
            self.lsr_m(self.abs_())
            return 6
        if op == 0x2A:
            nc = (self.a>>7)&1
            self.a = self.zn(((self.a<<1)|self.C)&0xFF)
            self.C = nc
            return 2
        if op == 0x6A:
            nc = self.a&1
            self.a = self.zn(((self.C<<7)|(self.a>>1))&0xFF)
            self.C = nc
            return 2
        # --- Stack Flags ---
        if op == 0x48:
            self.push(self.a)
            return 3
        if op == 0x68:
            self.a = self.zn(self.pull())
            return 4
        if op == 0x08:
            self.push(self.flags()|0x10)
            return 3
        if op == 0x28:
            self.set_flags(self.pull())
            return 4
        if op == 0x18:
            self.C = 0
            return 2
        if op == 0x38:
            self.C = 1
            return 2
        if op == 0x58:
            self.I = 0
            return 2
        if op == 0x78:
            self.I = 1
            return 2
        if op == 0xB8:
            self.V = 0
            return 2
        if op == 0xD8:
            self.D = 0
            return 2
        if op == 0xF8:
            self.D = 1
            return 2
        if op == 0xEA:
            return 2
        if op == 0x00:
            self.running = False
            LOG.log("[SYS] BRK stop")
            return 7
        # unknown
        c = self.unk.get(op, 0)+1
        self.unk[op] = c
        if c == 1:
            LOG.log(f"[WARN] OP {op:02X} unknown at {(self.pc-1)&0xFFFF:04X}")
        return 2
