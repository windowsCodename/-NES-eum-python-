# 1. Logger
# ------------------------------------------------------------
class Logger:
    def __init__(self):
        self.q = []
        self.lock = threading.Lock()
    def log(self, m):
        ts = time.strftime("%H:%M:%S")
        with self.lock:
            self.q.append(f"[{ts}] {m}")
    def poll_all(self):
        with self.lock:
            d = list(self.q)
            self.q.clear()
        return d
LOG = Logger()
